;;; ---------------------------------------------------------------
;;; Deliberately absent (13 of 89). Each needs a decision, not a
;;; declaration, and a wrong guess here is a silent ABI mismatch that
;;; neither the compiler nor the linker can catch.
;;;
;;; VARIADIC -- arity varies per call site; these are the busiest
;;; names in the surface (godot-call-v: 1116 call sites, 13 arities).
;;;   emit-signal          :void   arities min 1, first :cstr
;;;   godot-call           :int    arities [1, 2, 3, 4, 5, 6, 7, 8, 9]
;;;   godot-call-b         :bool   arities [2, 3, 4, 5, 7]
;;;   godot-call-c         :cstr   arities [2, 3, 4, 6]
;;;   godot-call-f         :float  arities [2, 3, 4]
;;;   godot-call-pack      :int    arities [3, 4, 5]
;;;   godot-call-pack-v    :void   arities [5, 6]
;;;   godot-call-v         :void   arities [2, 3, 4, 5, 6, 7, 8, 9, 10, 12, 13, 14, 15]
;;;   godot-signal         :void   arities [1, 2, 4]
;;;
;;; POLYMORPHIC -- one slot accepts several tags.
;;;   godot-export         :void   arg 2's type is decided by the VALUE of arg 1
;;;   godot-num->str       :cstr   arg 0 accepts three tags
;;;   godot-prop-set       :void   arg 1 is the property value
;;;
;;; CLOSURE -- a code pointer plus a captured environment, which
;;; cannot cross an extern-c boundary as a scalar.
;;;   godot-connect-typed  :void   arg 2 is a Turmeric closure
